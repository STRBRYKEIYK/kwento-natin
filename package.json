{
  "name": "kwento-natin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/date-scheduler"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run build:linked",
    "build:linked": "npm run build --workspace=@kwento-natin/date-scheduler && node scripts/build-linked-apps.mjs",
    "postbuild": "node scripts/build-one-eleven.mjs",
    "preview": "vite preview --host 127.0.0.1 --outDir dist",
    "test": "vitest run",
    "build:firebase": "node scripts/build-firebase.mjs",
    "test:firebase": "npm --prefix functions test && node scripts/verify-consolidation.mjs && node scripts/verify-firebase-build.mjs",
    "firebase:backup": "node scripts/firebase-database.mjs --backup",
    "firebase:database": "node scripts/firebase-database.mjs",
    "firebase:migrate-data": "node scripts/migrate-firebase-data.mjs --apply",
    "firebase:notifications": "node scripts/firebase-notifications.mjs --apply",
    "firebase:login": "firebase login",
    "firebase:deploy": "npm run build:firebase && npm run test:firebase && npm run firebase:check-secrets && firebase deploy --only hosting,functions:chicaApi --project chica-keicodes-dev",
    "firebase:telegram-setup": "node scripts/firebase-telegram-setup.mjs",
    "firebase:check-secrets": "node scripts/firebase-check-secrets.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "firebase": "^13.4.0",
    "framer-motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "15.37.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
