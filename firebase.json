{
  "hosting": [
    {
      "site": "chica-keicodes-dev",
      "public": ".firebase-hosting/main",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=0,must-revalidate"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/333{,/}",
          "destination": "/aircon",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/date/api/**",
          "function": {
            "functionId": "chicaApi",
            "region": "asia-southeast1"
          }
        },
        {
          "source": "/vouchers/api/**",
          "function": {
            "functionId": "chicaApi",
            "region": "asia-southeast1"
          }
        },
        {
          "source": "/555{,/**}",
          "destination": "/date/five/index.html"
        },
        {
          "source": "/date{,/**}",
          "destination": "/date/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "chica-keicodes-dev-dates",
