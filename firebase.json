  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "test",
      "*.log",
      ".env*"
    ],
    "predeploy": [
      "node scripts/firebase-check-secrets.mjs",
      "npm run firebase:vendor",
      "npm --prefix functions test"
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5050
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  }
}
