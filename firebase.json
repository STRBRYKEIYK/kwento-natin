            "functionId": "chicaApi",
            "region": "asia-southeast1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "chicaApi",
            "region": "asia-southeast1"
          }
        },
        {
          "source": "/555{,/**}",
